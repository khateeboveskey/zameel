{
  "$schema": "https://json.schemastore.org/package",
  "name": "zameel",
  "description": "زميل هو نظام إدارة محتوى الطالب",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "fix": "npx expo install --fix",
    "upgrade:tamagui": "$npm_execpath up '*tamagui*' '@tamagui/*'",
    "generate-themes": "tamagui generate-themes ./themes/theme-builder.ts ./themes/theme-output.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tamagui/animations-react-native": "^1.126.13",
    "@tamagui/babel-plugin": "^1.126.13",
    "@tamagui/cli": "^1.126.13",
    "@tamagui/config": "^1.126.13",
    "@tamagui/lucide-icons": "^1.126.13",
    "@tamagui/themes": "^1.126.13",
    "axios": "^1.9.0",
    "expo": "^53.0.9",
    "expo-build-properties": "~0.14.6",
    "expo-constants": "~17.1.6",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.1",
    "expo-linear-gradient": "~14.1.4",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.7",
    "expo-splash-screen": "~0.30.8",
    "lucide-react-native": "^0.511.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-gifted-chat": "^2.8.1",
    "react-native-keyboard-controller": "^1.17.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-password-validate-checklist": "^1.0.1",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.0",
    "react-native-toastable": "^0.5.0",
    "tamagui": "^1.126.13",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@manypkg/cli": "^0.24.0",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3"
  },
  "volta": {
    "node": "20.10.0"
  },
  "private": true
}
